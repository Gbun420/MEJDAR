FROM php:8.3-fpm-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpng-dev \
    libjpeg62-turbo-dev \
    libwebp-dev \
    libzip-dev \
    zip \
    unzip \
    curl \
    libicu-dev \
    libonig-dev \
    libxml2-dev \
    libsqlite3-dev \
    autoconf \
    g++ \
    make \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) \
    pdo \
    pdo_mysql \
    mbstring \
    zip \
    exif \
    pcntl \
    bcmath \
    gd \
    opcache \
    intl \
    xml \
    soap \
    && pecl install redis xdebug \
    && docker-php-ext-enable redis xdebug \
    && rm -rf /var/lib/apt/lists/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# PHP development configuration
RUN cp "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"

# Custom PHP settings
RUN echo "memory_limit = 512M" >> "$PHP_INI_DIR/conf.d/mejdar.ini" \
    && echo "upload_max_filesize = 20M" >> "$PHP_INI_DIR/conf.d/mejdar.ini" \
    && echo "post_max_size = 25M" >> "$PHP_INI_DIR/conf.d/mejdar.ini" \
    && echo "max_execution_time = 120" >> "$PHP_INI_DIR/conf.d/mejdar.ini" \
    && echo "display_errors = On" >> "$PHP_INI_DIR/conf.d/mejdar.ini" \
    && echo "error_reporting = E_ALL" >> "$PHP_INI_DIR/conf.d/mejdar.ini"

# Xdebug configuration
RUN echo "xdebug.mode=debug" >> "$PHP_INI_DIR/conf.d/xdebug.ini" \
    && echo "xdebug.start_with_request=yes" >> "$PHP_INI_DIR/conf.d/xdebug.ini" \
    && echo "xdebug.client_host=host.docker.internal" >> "$PHP_INI_DIR/conf.d/xdebug.ini" \
    && echo "xdebug.client_port=9003" >> "$PHP_INI_DIR/conf.d/xdebug.ini" \
    && echo "xdebug.idekey=MEJDAR" >> "$PHP_INI_DIR/conf.d/xdebug.ini"

# OPcache settings for development
RUN echo "opcache.enable=1" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.memory_consumption=128" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.interned_strings_buffer=8" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.max_accelerated_files=10000" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.validate_timestamps=1" >> "$PHP_INI_DIR/conf.d/opcache.ini"

# Create php-fpm status page for healthchecks
RUN echo "pm.status_path = /status" >> "$PHP_INI_DIR/conf.d/mejdar-fpm.ini"

WORKDIR /var/www/html

# Create non-root user
RUN groupadd -g 1000 www && useradd -u 1000 -g www -m -s /bin/false www

EXPOSE 9000

CMD ["php-fpm"]
